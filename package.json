{
  "name": "problems-at-ap-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "typecheck": "npm --prefix frontend run typecheck",
    "backend:dev": "uv run --directory backend uvicorn app.main:app --reload --port 8000",
    "backend:test": "uv run --directory backend pytest -v",
    "backend:start": "uv run --directory backend python run.py"
  }
}
