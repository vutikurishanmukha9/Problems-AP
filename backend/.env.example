# Problems@AP Backend Environment Configuration
PROJECT_NAME="Problems@AP API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (SQLite development / PostgreSQL production)
# SQLite: sqlite+aiosqlite:///./problems_ap.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/problems_ap
DATABASE_URL="sqlite+aiosqlite:///./problems_ap.db"

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
